{"record": "line", "stream": "stdout", "elapsed_ms": 3277.304, "text": "{\"type\":\"tool_result\",\"tool_call_id\":\"toolu_bdrk_01YHTjGGRWky9KfWe1AE9WZN\",\"tool_name\":\"read_file\",\"output\":{\"bytes\":210,\"content\":\"pub fn invoice_cache_key(tenant: &str, invoice_id: &str) -> String {\\n    format!(\\\"northstar:{tenant}:{invoice_id}:v2\\\")\\n}\\n\\npub const CACHE_TTL_SECONDS: u64 = 900;\\npub const NEGATIVE_CACHE_TTL_SECONDS: u64 = 30;\\n\",\"truncated\":false},\"is_error\":false}"}
