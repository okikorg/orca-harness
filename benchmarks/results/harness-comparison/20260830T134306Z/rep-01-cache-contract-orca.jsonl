{"record": "line", "stream": "stdout", "elapsed_ms": 3277.394, "text": "{\"type\":\"tool_result\",\"tool_call_id\":\"toolu_bdrk_01Aono8Kp57Rzup5Ba7Hot2H\",\"tool_name\":\"read_file\",\"output\":{\"bytes\":171,\"content\":\"# Worker operations\\n\\nWorkers send a heartbeat every 30 seconds. The production timeout is 75 seconds\\nso one delayed heartbeat does not immediately evict a healthy worker.\\n\",\"truncated\":false},\"is_error\":false}"}
